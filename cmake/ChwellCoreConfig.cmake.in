@PACKAGE_INIT@
# Resolve our path before dependency configs can change PACKAGE_PREFIX_DIR (CMake <3.30).
set_and_check(CHWELL_ENTITY_SCHEMA_TOOL "@PACKAGE_CHWELL_TOOL_DIR@/entity_schema.py")
include(CMakeFindDependencyMacro)
find_dependency(Threads)
if(@CHWELL_USE_YAML@)
    find_dependency(yaml-cpp 0.6)
    if(NOT TARGET yaml-cpp::yaml-cpp AND TARGET yaml-cpp)
        add_library(yaml-cpp::yaml-cpp ALIAS yaml-cpp)
    endif()
endif()
if(@CHWELL_USE_OPENSSL@)
    find_dependency(OpenSSL)
endif()
if(@CHWELL_USE_PROTOBUF@)
    find_dependency(Protobuf)
endif()
if(@CHWELL_USE_CONSUL@)
    find_dependency(CURL 7.68)
    find_dependency(nlohmann_json 3.11)
endif()
set(_chwell_saved_module_path "${CMAKE_MODULE_PATH}")
list(APPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}")
if(@CHWELL_USE_MYSQL@)
    find_dependency(ChwellMySQL)
endif()
if(@CHWELL_USE_MONGODB@)
    find_dependency(ChwellMongoDB)
endif()
set(CMAKE_MODULE_PATH "${_chwell_saved_module_path}")
unset(_chwell_saved_module_path)
include("${CMAKE_CURRENT_LIST_DIR}/ChwellCoreTargets.cmake")
set(ChwellCore_core_FOUND TRUE)
foreach(_chwell_module schema consul game_proto)
    if(TARGET Chwell::${_chwell_module})
        set(ChwellCore_${_chwell_module}_FOUND TRUE)
    else()
        set(ChwellCore_${_chwell_module}_FOUND FALSE)
    endif()
endforeach()
unset(_chwell_module)
include("${CMAKE_CURRENT_LIST_DIR}/ChwellEntitySchema.cmake")
check_required_components(ChwellCore)
