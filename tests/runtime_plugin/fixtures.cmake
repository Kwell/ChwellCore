set(CHWELL_RUNTIME_FIXTURE_DIR "${CMAKE_CURRENT_LIST_DIR}")
function(chwell_runtime_plugin_fixtures target)
    foreach(variant v1 v2 v3 wrong_abi wrong_name zero_version wrong_size)
        add_library(runtime_plugin_${variant} SHARED "${CHWELL_RUNTIME_FIXTURE_DIR}/fixture.cpp")
        target_include_directories(runtime_plugin_${variant} PRIVATE "${CHWELL_RUNTIME_FIXTURE_DIR}/../../include")
        target_compile_features(runtime_plugin_${variant} PRIVATE cxx_std_17)
        target_link_libraries(runtime_plugin_${variant} PRIVATE Threads::Threads)
        if(variant STREQUAL "v2")
            target_compile_definitions(runtime_plugin_${variant} PRIVATE PLUGIN_VERSION=2)
        elseif(variant STREQUAL "v3")
            target_compile_definitions(runtime_plugin_${variant} PRIVATE PLUGIN_VERSION=3)
        elseif(variant STREQUAL "wrong_abi")
            target_compile_definitions(runtime_plugin_${variant} PRIVATE PLUGIN_ABI=999)
        elseif(variant STREQUAL "wrong_name")
            target_compile_definitions(runtime_plugin_${variant} PRIVATE PLUGIN_NAME="wrong.logic")
        elseif(variant STREQUAL "zero_version")
            target_compile_definitions(runtime_plugin_${variant} PRIVATE PLUGIN_VERSION=0)
        elseif(variant STREQUAL "wrong_size")
            target_compile_definitions(runtime_plugin_${variant} PRIVATE PLUGIN_STRUCT_SIZE=8)
        endif()
        add_dependencies(${target} runtime_plugin_${variant})
        string(TOUPPER "${variant}" variant_upper)
        target_compile_definitions(${target} PRIVATE "RUNTIME_PLUGIN_${variant_upper}=\"$<TARGET_FILE:runtime_plugin_${variant}>\"")
    endforeach()
endfunction()
